 <!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Formularz zgłoszeniowy — CREW Graffiti</title>

<style>
  :root{
    --paper-width: 880px;
    --paper-height: 1240px;
    --paper-bg: #fffdf9;
    --line-color: #cfcfcf;
    --accent: #7b5ea3;
  }

  html,body{
    height:100%;
    margin:0;
    background: linear-gradient(180deg,var(--accent), #6b4f8a);
    font-family: Arial, sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:30px;
  }

  .sheet{
    width:var(--paper-width);
    height:var(--paper-height);
    background: var(--paper-bg);
    box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    padding:28px 34px;
    border-radius:6px;
    position:relative;
    box-sizing:border-box;
  }

  header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
  }

  .title{
    font-size:32px;
    font-weight:600;
    color:#303030;
    margin-bottom:6px;
  }

  .subtitle{
    font-size:16px;
    color:#333;
    margin-top:4px;
  }

  .right-box{
    border:2px solid #b7b7b7;
    padding:10px 18px;
    font-size:20px;
    border-radius:4px;
    text-align:center;
  }

  .form{
    margin-top:12px;
  }

  label.section-title{
    display:block;
    margin:16px 0 8px;
    font-size:18px;
    font-weight:600;
    color:#333;
  }

  .row{
    display:flex;
    gap:16px;
    align-items:center;
    margin-bottom:12px;
  }

  .label{
    width:160px;
    color:#555;
  }

  .input{
    border:2px solid var(--line-color);
    padding:10px;
    min-height:24px;
    border-radius:4px;
    background:white;
    font-size:15px;
    color:#222;
    flex:1;
  }

  .small-boxes{
    display:flex;
    gap:8px;
  }

  .small-box{
    width:50px;
    border:2px solid var(--line-color);
    padding:8px;
    text-align:center;
    border-radius:4px;
    background:white;
  }

  .checkboxes{
    display:flex;
    gap:16px;
  }

  .style-row{
    display:flex;
    gap:10px;
    margin:8px 0 20px;
  }

  .style-box{
    border:2px solid var(--line-color);
    padding:8px 14px;
    border-radius:4px;
    background:white;
    min-width:110px;
    text-align:center;
  }

  .portfolio{
    width:300px;
    border:2px solid var(--line-color);
    padding:10px;
    background:white;
    border-radius:4px;
  }

  .notes{
    width:320px;
    height:220px;
    border:2px solid var(--line-color);
    border-radius:4px;
    background:white;
  }

  .footer-note{
    position:absolute;
    left:34px;
    bottom:20px;
    font-size:14px;
    color:#777;
  }

  .req{
    color:#a54fd8;
    margin-left:4px;
  }
</style>
</head>
<body>

  <div class="sheet">

    <header>
      <div>
        <div class="title">Formularz Zgłoszeniowy do CREW Graffiti</div>
        <div class="subtitle">Dane Osobiste</div>
      </div>

      <div class="right-box">GDN39</div>
    </header>

    <main class="form">

      <div class="row">
        <div class="label">Imię: <span class="req">*</span></div>
        <input class="input">
        <div class="label" style="width:120px;">Nazwisko: <span class="req">*</span></div>
        <input class="input" style="flex:0.6">
      </div>

      <div class="row">
        <div class="label">Data zgłoszenia:</div>
        <input class="input" style="width:220px;">
      </div>

      <div class="row">
        <div class="label">Pseudonim (Nick):</div>
        <input class="input" style="flex:0.7">
        <div class="label" style="width:150px;">Data urodzenia: <span class="req">*</span></div>
        <div class="small-boxes">
          <div class="small-box">DD</div>
          <div class="small-box">MM</div>
          <div class="small-box">RRRR</div>
        </div>
      </div>

      <div class="row">
        <div class="label">Miasto zamieszkania: <span class="req">*</span></div>
        <input class="input">
      </div>

      <div class="row">
        <div class="label">EMAIL: <span class="req">*</span></div>
        <input class="input" style="width:320px;">
      </div>

      <div class="row">
        <div class="label">Numer telefonu:</div>
        <input class="input" style="width:260px;">
      </div>

      <label class="section-title">Informacje o działalności</label>

      <div class="row">
        <div class="label">Języki którymi rozmawiasz:</div>
        <div class="checkboxes">
          <label><input type="checkbox"> Angielski</label>
          <label><input type="checkbox"> Niemiecki</label>
          <label><input type="checkbox"> Francuski</label>
        </div>
      </div>

      <div class="row">
        <div class="label">Ulubiony Napój: <span class="req">*</span></div>
        <input class="input" style="width:340px;">
      </div>

      <label class="section-title">Style Rysowania</label>

      <div class="style-row">
        <div class="style-box">Bubble</div>
        <div class="style-box">Wildstyle</div>
        <div class="style-box">Throw up</div>
        <div class="style-box">Realism</div>
        <div class="style-box">Inny</div>
      </div>

      <div style="display:flex; gap:28px;">
        <div style="flex:1">
          <div style="margin-bottom:6px;color:#555;">Link do portfolio (inst.)</div>
          <div class="portfolio"></div>
        </div>
        <div>
          <div style="margin-bottom:6px;color:#555;">Notatki dla CREW:</div>
          <div class="notes"></div>
        </div>
      </div>

      <div class="footer-note">Pomohowych Ilka</div>

    </main>

  </div>
</body>
</html>
