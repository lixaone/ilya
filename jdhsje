<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Formularz zgłoszeniowy — CREW Graffiti</title>

<!-- рукописный шрифт из Google Fonts (чтобы выглядило как на рисунке) -->
<link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Shadows+Into+Light&display=swap" rel="stylesheet">

<style>
  :root{
    --paper-width: 880px;       /* имитируем лист бумаги */
    --paper-height: 1240px;
    --paper-bg: #fffdf9;
    --line-color: #d6d6d6;
    --box-color: #e9e9e9;
    --accent: #7b5ea3; /* фиолетовый фон страницы */
    --hand: "Patrick Hand", "Shadows Into Light", sans-serif;
  }

  html,body{
    height:100%;
    margin:0;
    background: linear-gradient(180deg,var(--accent), #6b4f8a);
    font-family: var(--hand);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:30px;
  }

  /* лист бумаги */
  .sheet{
    width:var(--paper-width);
    height:var(--paper-height);
    background: var(--paper-bg);
    box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    padding:28px 34px;
    box-sizing:border-box;
    position:relative;
    border-radius:6px;
    overflow:hidden;
  }

  /* тонкие направляющие линии (как на рисунке) */
  .sheet::before{
    content:"";
    position:absolute;
    left:34px;
    right:34px;
    top:120px;
    bottom:34px;
    background-image: linear-gradient(to bottom, transparent 0, transparent 26px, rgba(0,0,0,0.03) 27px);
    opacity:0.9;
    pointer-events:none;
  }

  header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:8px;
  }

  .title{
    font-size:34px;
    letter-spacing:1px;
    line-height:1;
    color:#2b2b2b;
  }
  .subtitle{
    font-size:14px;
    color:#2b2b2b;
    margin-top:6px;
  }

  .right-box{
    border:2px solid #cfc9c2;
    padding:10px 16px;
    font-size:18px;
    border-radius:6px;
    text-align:center;
    color:#3b3b3b;
  }

  /* основной контейнер полей */
  .form{
    margin-top:12px;
    position:relative;
    z-index:1;
  }

  label.section-title{
    display:block;
    margin:14px 0 6px;
    font-size:18px;
    color:#3a3a3a;
  }

  .row{
    display:flex;
    gap:16px;
    align-items:center;
    margin-bottom:12px;
  }

  .row .label{
    width:120px;
    min-width:120px;
    color:#666;
    font-size:16px;
  }

  /* поля ввода - нарисованные прямоугольники */
  .input{
    border:2px solid var(--line-color);
    background: transparent;
    padding:10px 12px;
    min-height:28px;
    border-radius:3px;
    box-sizing:border-box;
    font-family:var(--hand);
    font-size:16px;
    color:#222;
    flex:1;
  }

  /* специальные маленькие поля (дата) */
  .small-boxes{
    display:flex;
    gap:8px;
    align-items:center;
  }
  .small-box{
    width:48px;
    border:2px solid var(--line-color);
    padding:6px 8px;
    text-align:center;
    border-radius:3px;
    background:transparent;
    font-size:15px;
    min-height:28px;
  }

  /* пустые прямоугольники для чекбоксов по стилям */
  .checkboxes{
    display:flex;
    gap:12px;
    align-items:center;
    margin-top:6px;
  }
  .tick{
    display:inline-flex;
    align-items:center;
    gap:6px;
    min-width:100px;
    font-size:15px;
    color:#333;
  }
  .tick input[type="checkbox"]{
    width:18px;
    height:18px;
  }

  /* ряд маленьких прямоугольников (style rysowania) */
  .style-row{
    display:flex;
    gap:10px;
    margin:8px 0 18px;
  }
  .style-box{
    border:2px solid var(--line-color);
    padding:8px 14px;
    min-width:110px;
    text-align:center;
    border-radius:3px;
    background:transparent;
    font-size:15px;
  }

  /* небольшое поле для ссылки портфолио */
  .portfolio{
    width:320px;
    border:2px solid var(--line-color);
    padding:10px 12px;
    font-size:15px;
    border-radius:3px;
    background:transparent;
  }

  /* большое поле заметок (как квадрат) */
  .notes{
    width:320px;
    height:220px;
    border:2px solid var(--line-color);
    border-radius:4px;
    background:transparent;
  }

  /* подпись внизу */
  .footer-note{
    position:absolute;
    left:34px;
    bottom:20px;
    font-size:14px;
    color:#666;
  }

  /* вспомогательные стили для выравнивания полей */
  .two-cols{
    display:flex;
    gap:12px;
  }
  .fixed-small{ width:220px; }
  .fixed-mid{ width:320px; }

  /* имитация лёгкого карандашного вида линий */
  .input, .small-box, .style-box, .right-box, .portfolio, .notes{
    box-shadow: inset 0 0 0 0 rgba(0,0,0,0.02);
  }

  /* мелкая подпись-звездочка */
  .req { color:#a56bba; margin-left:6px; font-size:14px; vertical-align:middle; }

  /* адаптив */
  @media (max-width:960px){
    :root{ --paper-width:680px; --paper-height:980px; }
    .sheet{ padding:18px; }
  }
</style>
</head>
<body>
  <div class="sheet" role="document" aria-label="Formularz zgłoszeniowy do CREW Graffiti">
    <header>
      <div>
        <div class="title">FORMULARZ <span style="font-size:22px">Zgłoszeniowy do <strong>CREW</strong> Graffiti</span></div>
        <div class="subtitle">DANE OSOBISTE</div>
      </div>

      <div class="right-box">GDN39</div>
    </header>

    <main class="form" >
      <!-- Imię / Nazwisko / Data zgłoszenia -->
      <div class="row">
        <div class="label">Imię: <span class="req">*</span></div>
        <input class="input" placeholder=" " />
        <div style="width:130px;min-width:130px">Nazwisko: <span class="req">*</span></div>
        <input class="input fixed-small" placeholder=" " />
      </div>

      <div class="row">
        <div class="label">Data zgłoszenia</div>
        <input class="input" style="width:180px" placeholder=" " />
      </div>

      <!-- Pseudonim / Data urodzenia -->
      <div class="row">
        <div class="label">Pseudonim (Nick):</div>
        <input class="input" style="flex:0.6" placeholder=" " />
        <div style="width:140px">Data urodzenia: <span class="req">*</span></div>
        <div class="small-boxes">
          <div class="small-box">DD</div>
          <div class="small-box">MM</div>
          <div class="small-box">RRRR</div>
        </div>
      </div>

      <!-- Miasto zamieszkania / Email -->
      <div class="row">
        <div class="label">Miasto zamieszkania: <span class="req">*</span></div>
        <input class="input" placeholder=" " />
      </div>

      <div class="row">
        <div class="label">EMAIL: <span class="req">*</span></div>
        <input class="input fixed-mid" placeholder=" " />
      </div>

      <div class="row">
        <div class="label">Numer telefonu:</div>
        <input class="input fixed-small" placeholder=" " />
      </div>

      <label class="section-title">INFORMACJE O DZIAŁALNOŚCI</label>

      <!-- Języki -->
      <div class="row">
        <div class="label">Języki którymi rozmawiasz</div>
        <div class="checkboxes" style="flex:1">
          <label class="tick"><input type="checkbox" /> ANGIELSKI</label>
          <label class="tick"><input type="checkbox" /> Niemiecki</label>
          <label class="tick"><input type="checkbox" /> Francuski</label>
        </div>
      </div>

      <!-- Ulubiony napój -->
      <div class="row">
        <div class="label">Ulubiony Napój: <span class="req">*</span></div>
        <input class="input" style="width:340px" placeholder=" " />
      </div>

      <label class="section-title">Style Rysowania</label>

      <div class="style-row">
        <div class="style-box">Bubble</div>
        <div class="style-box">Wildstyle</div>
        <div class="style-box">Throw up</div>
        <div class="style-box">Realism</div>
        <div class="style-box">Inny</div>
      </div>

      <div style="display:flex; gap:28px; margin-top:10px; align-items:flex-start;">
        <div style="flex:1">
          <div style="margin-bottom:8px; color:#666">link do portfolio (inst.)</div>
          <div class="portfolio"></div>
        </div>

        <div style="width:380px">
          <div style="margin-bottom:8px; color:#666">Notatki dla CREW:</div>
          <div class="notes"></div>
        </div>
      </div>

      <!-- нижняя подпись -->
      <div class="footer-note">Pomohowych: Ilka</div>

    </main>
  </div>
</body>
</html>
