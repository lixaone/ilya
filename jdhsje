 <!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<title>Formularz CREW Graffiti</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: white;
        padding: 20px;
    }

    .container {
        width: 800px;
        margin: auto;
        border: 1px solid #ccc;
        padding: 20px;
    }

    h1 {
        font-size: 26px;
        margin-bottom: 5px;
    }

    .small-title {
        font-size: 16px;
        margin-bottom: 15px;
    }

    label {
        display: inline-block;
        width: 200px;
        margin-bottom: 8px;
    }

    input[type="text"],
    input[type="email"],
    input[type="number"] {
        width: 250px;
        padding: 5px;
        border: 1px solid #888;
    }

    .three-boxes input {
        width: 40px;
        text-align: center;
    }

    .style-boxes div {
        border: 1px solid #888;
        padding: 4px 10px;
        display: inline-block;
        margin-right: 10px;
        margin-top: 5px;
    }

    textarea {
        width: 300px;
        height: 150px;
        border: 1px solid #888;
    }

    .buttons {
        margin-top: 20px;
    }

    button {
        padding: 8px 20px;
        margin-right: 15px;
    }

    .right-code {
        float: right;
        border: 1px solid #888;
        padding: 8px 15px;
        font-size: 20px;
    }

</style>

</head>
<body>

<div class="container">

    <div class="right-code">GDN39</div>

    <h1>Formularz Zgłoszeniowy do CREW Graffiti</h1>
    <div class="small-title">Dane Osobiste</div>

    <form>

        <label>Imię: *</label>
        <input type="text"><br>

        <label>Nazwisko: *</label>
        <input type="text"><br>

        <label>Data zgłoszenia:</label>
        <input type="text"><br>

        <label>Pseudonim (Nick):</label>
        <input type="text"><br>

        <label>Data urodzenia: *</label>
        <div class="three-boxes" style="display:inline-block;">
            <input type="text" placeholder="DD">
            <input type="text" placeholder="MM">
            <input type="text" placeholder="RRRR">
        </div><br><br>

        <label>Miasto zamieszkania: *</label>
        <input type="text"><br>

        <label>Email: *</label>
        <input type="email"><br>

        <label>Numer telefonu:</label>
        <input type="text"><br><br>

        <h3>Informacje o działalności</h3>

        <label>Języki którymi rozmawiasz:</label>
        <input type="checkbox"> Angielski
        <input type="checkbox"> Niemiecki
        <input type="checkbox"> Francuski
        <br><br>

        <label>Ulubiony napój: *</label>
        <input type="text"><br><br>

        <h3>Style Rysowania</h3>

        <div class="style-boxes">
            <div>Bubble</div>
            <div>Wildstyle</div>
            <div>Throw-up</div>
            <div>Realism</div>
            <div>Inny</div>
        </div>
        <br><br>

        <label>Link do portfolio (inst.):</label>
        <input type="text"><br><br>

        <label>Notatki dla CREW:</label>
        <textarea></textarea>
        <br><br>

        <div class="buttons">
            <button type="reset">Reset</button>
            <button type="submit">Submit</button>
        </div>

    </form>

    <br><br>
    <div>Pomohowych Ilka</div>

</div>

</body>
</html>
